{
  "env": {
    "OB_URL": "http://127.0.0.1:18001",
    "OB_HOOK_TOKEN": "换成你在 Ombre Brain 里设置的 hook token"
  },
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "python3 ~/.claude/hooks/ob_hook.py session-start", "timeout": 45 } ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "python3 ~/.claude/hooks/ob_hook.py prompt", "timeout": 15 } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "python3 ~/.claude/hooks/ob_hook.py stop", "timeout": 20 } ] }
    ],
    "SessionEnd": [
      { "hooks": [ { "type": "command", "command": "python3 ~/.claude/hooks/ob_hook.py session-end", "timeout": 10 } ] }
    ],
    "PreCompact": [
      { "hooks": [ { "type": "command", "command": "python3 ~/.claude/hooks/ob_hook.py pre-compact", "timeout": 10 } ] }
    ]
  }
}
