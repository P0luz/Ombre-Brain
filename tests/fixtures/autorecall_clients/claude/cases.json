            "description": "tail logs",
            "command": "tail -f /var/log/syslog"
          }
        ],
        "session_crons": [
          {
            "id": "cron-001",
            "schedule": "0 9 * * 1-5",
            "recurring": true,
            "prompt": "check the build"
          }
        ]
      },
      "expect_post": {
        "path": "stop",
        "fields": {
          "session_id": "abc123",
          "client": "claude"
