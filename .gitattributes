# Shell scripts must stay LF — CRLF would break the `#!/bin/sh` shebang inside the
# Linux container (`bad interpreter: /bin/sh^M`). Critical for entrypoint.sh, which
# the Dockerfile COPYs and runs as ENTRYPOINT. Enforce LF on every checkout/build host.
*.sh text eol=lf
entrypoint.sh text eol=lf

# Security dependency upgrades require an explicit image rebuild or locked pip
# install. Include both dependency manifests in archives so legacy updaters do
# not mistake this release for a code-only update. See docs/DEPENDENCY_SECURITY_20261102.md.
