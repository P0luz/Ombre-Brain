# ============================================================
# Ombre-Brain 环境变量模板
# Copy to `.env` (gitignored) and fill in your own values.
# ============================================================

# ---- Compress / 脱水压缩 LLM（必需）---------------------------
# 用于 hold / grow / dream 等所有调 LLM 的工具。
# 任意 OpenAI 兼容 endpoint：DeepSeek / Gemini / Ollama / vLLM / SiliconFlow…
OMBRE_COMPRESS_API_KEY=change-me
OMBRE_COMPRESS_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OMBRE_COMPRESS_MODEL=gemini-2.5-flash-lite
OMBRE_COMPRESS_TIMEOUT_SECONDS=120

# ---- Embed / 向量化（可选，缺则语义检索关闭）-------------------
# 使用云端 OpenAI 兼容 endpoint，下面三项必填，可与 Compress 复用同一个 key/base。
OMBRE_EMBED_BACKEND=api                # 只支持 api
OMBRE_EMBED_API_KEY=change-me
OMBRE_EMBED_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OMBRE_EMBED_MODEL=gemini-embedding-001
OMBRE_EMBED_TIMEOUT_SECONDS=120

# ---- Storage / 存储 ----------------------------------------
# 桶 markdown、config.yaml 和 Tunnel token 在「宿主机」上的持久目录。
# docker compose 会把它挂到容器 /app/buckets。
# 源码版请把本项放进 deploy/.env；独立 docker-compose.user.yml 则放在其同目录 .env。
# Windows 推荐使用正斜杠，例如 D:/Ombre-Brain/buckets-data。
OMBRE_HOST_VAULT_DIR=/absolute/path/to/your/vault

# 仅当你「不走 docker、直接 python/pytest」时取消注释，指向同一目录。
# compose 启动时不要设——容器内已固定为 /app/buckets。
# OMBRE_BUCKETS_DIR=/absolute/path/to/your/vault

# ---- Transport / 协议 --------------------------------------
# stdio = 本地 Claude Desktop；streamable-http = 容器/远程
OMBRE_TRANSPORT=streamable-http

# Cloudflare Tunnel：绕过不支持 SRV 查询的 VPN DNS，并固定走 TCP/HTTP2。
# 双 region 可避免只连一个 edge 时进入降级状态。Compose 模板已内置相同默认值。
TUNNEL_EDGE=region1.v2.argotunnel.com:7844,region2.v2.argotunnel.com:7844
TUNNEL_TRANSPORT_PROTOCOL=http2
# DNS 支持 SRV 且希望恢复 cloudflared 原生发现/QUIC 时，设置 TUNNEL_EDGE= 并把协议改为 auto。

# ---- Dashboard 访问密码（可选）--------------------------------
# 设置后 Dashboard 页面会要求输入密码才能访问。
# OMBRE_DASHBOARD_PASSWORD=change-me
# Optional one-time secret for intentionally bootstrapping from a non-loopback
# client. Prefer setting OMBRE_DASHBOARD_PASSWORD before public deployment.
# OMBRE_SETUP_TOKEN=replace-with-a-long-random-secret
# Dashboard 登录默认 30 天过期，可设 1-365 天；旧版近永久会话升级后会被收短。
# OMBRE_DASHBOARD_SESSION_DAYS=30
# 只有这些反代来源的 X-Forwarded-* 会被信任；内置 Tunnel 同进程走 loopback。
# 至少填直接连接 OB 的最后一跳 nginx/代理 CIDR，不是公网客户端 IP 或域名。
# X-Forwarded-For 从右往左跳过这些网段取客户端；CDN 公共网段先看 docs/OPERATIONS.md。
# 官方 Compose 模板会把本项传入容器；修改后需 force-recreate，勿填 0.0.0.0/0。
# OMBRE_TRUSTED_PROXY_CIDRS=127.0.0.0/8,::1/128

# ---- Hooks / HTTP 钩子鉴权（可选）------------------------------
# /breath-hook 和 /dream-hook 默认不再公开；可使用 Dashboard 登录态或设置 token。
# 调用方式：请求头 X-Ombre-Hook-Token: ... / Authorization: Bearer ...（不支持 URL 参数）。
# OMBRE_HOOK_TOKEN=change-me
# OMBRE_HOOK_ALLOW_PUBLIC=false

# ---- MCP OAuth + 静态 Token 共存（可选）--------------------------
# 默认 /mcp 只走 OAuth 2.1。若同一实例还要服务不实现 OAuth 的客户端，推荐设为 hybrid；
# OAuth 动态注册继续可用，同时接受预置静态 Bearer。设为 token 则只保留静态 Token，
# OAuth 的发现/授权路由会全部 404。
# 调用方式：请求头 Authorization: Bearer <token> 或 Ombre-MCP-Token: <token>（不支持 URL 参数）。
# ⚠️ 和关闭鉴权一样：请勿把服务直接暴露公网，Token 泄露等同任何人都能读写全部记忆。
# OMBRE_MCP_AUTH_MODE=hybrid
# OMBRE_MCP_TOKEN=change-me

# ---- AI 显示名 / AI display name（可选）-----------------------
# AI 一方的称呼，用于面向用户的文案（删除通知、信件署名等）与 letter 默认署名。
# 不设置时回退为 "AI"。例：AI_NAME=Ombre
# AI_NAME=

# ---- 可选 ---------------------------------------------------
# Compose 宿主端口默认只绑定本机；改成 0.0.0.0 前必须启用 OAuth 或静态 Token。
OMBRE_BIND_ADDRESS=127.0.0.1
# OMBRE_PORT=8000
# 裸机仅本机使用时建议显式回环；容器/PaaS 的进程监听通常仍需 0.0.0.0。
# OMBRE_BIND_HOST=127.0.0.1
# Dashboard/向导保存非回环免鉴权组合、或内置 Tunnel 免鉴权启动时的高风险确认。
# OMBRE_ALLOW_INSECURE_MCP=false
