{
  "client": "antigravity",
  "sources": [
    "agy 1.3.5 内置钩子文档（二进制里的 hooks.md）：公共字段 conversationId / workspacePaths / transcriptPath / artifactDirectoryPath / modelName；PreInvocation 的 invocationNum / initialNumSteps；Stop 的 executionNum / terminationReason / error / fullyIdle；输出 injectSteps",
    "记录文件行格式：lidge-ai/cli-jaw（MIT）tests/unit/agy-transcript.test.ts 的用例；heyxiaoc/not-fade-away 机看版 §5",
    "未经真机验证：开发者账号过不了 agy 的资格检查"
  ],
  "cases": [
    {
      "name": "SessionStart（文档公共字段）",
      "argv": [
        "--client",
        "antigravity",
        "session-start"
      ],
      "stdin": {
        "conversationId": "ec33ebf9-0cba-4100-8142-c61503f6c587",
        "workspacePaths": [
          "/path/to/workspace"
        ],
        "transcriptPath": "",
        "artifactDirectoryPath": "/path/to/workspace/.gemini/antigravity-cli/artifacts",
        "modelName": "auto"
      },
      "expect_post": {
        "path": "session-start",
        "fields": {
          "session_id": "ec33ebf9-0cba-4100-8142-c61503f6c587",
          "cwd": "/path/to/workspace",
          "client": "antigravity"
        }
      },
      "expect_stdout": {
        "injectSteps": [
          {
            "systemMessage": {
              "systemMessage": "[接续] 上次聊到猫"
            }
          }
        ]
      }
    },
    {
      "name": "PreInvocation 一轮的第一次调用",
      "argv": [
        "--client",
        "antigravity",
        "prompt"
      ],
      "stdin": {
        "conversationId": "ag-1",
        "workspacePaths": [
          "/w"
        ],
        "modelName": "auto",
        "invocationNum": 1,
        "initialNumSteps": 1
      },
      "transcript_rows": [
        {
          "step_index": 0,
          "type": "USER_INPUT",
          "status": "DONE",
          "content": "<USER_REQUEST>\n你还记得我的猫吗\n</USER_REQUEST>"
        }
      ],
      "expect_post": {
        "path": "prompt",
        "fields": {
          "prompt": "你还记得我的猫吗",
          "prompt_id": "agy:ag-1:0",
          "client": "antigravity"
        }
      },
      "expect_stdout": {
        "injectSteps": [
          {
            "systemMessage": {
              "systemMessage": "[记忆] 猫叫阿树"
            }
          }
        ]
      }
    },
    {
      "name": "PreInvocation 工具调用后的再次调用：不再召回",
      "argv": [
        "--client",
        "antigravity",
        "prompt"
      ],
      "stdin": {
        "conversationId": "ag-1",
        "workspacePaths": [
          "/w"
        ],
        "modelName": "auto",
        "invocationNum": 2,
        "initialNumSteps": 1
      },
      "transcript_rows": [
        {
          "step_index": 0,
          "type": "USER_INPUT",
          "status": "DONE",
          "content": "<USER_REQUEST>\n你还记得我的猫吗\n</USER_REQUEST>"
        },
        {
          "step_index": 1,
          "type": "PLANNER_RESPONSE",
          "status": "DONE",
          "content": "我先看看",
          "tool_calls": [
            {
              "name": "list_directory"
            }
          ]
        },
        {
          "step_index": 2,
          "type": "LIST_DIRECTORY",
          "status": "DONE",
          "content": "a.txt"
        }
      ],
      "expect_post": null,
      "expect_stdout": {}
    },
    {
      "name": "Stop NO_TOOL_CALL：存最终回复与原话",
      "argv": [
        "--client",
        "antigravity",
        "stop"
      ],
      "stdin": {
        "conversationId": "ag-1",
        "workspacePaths": [
          "/w"
        ],
        "modelName": "auto",
        "executionNum": 1,
        "terminationReason": "NO_TOOL_CALL",
        "error": "",
        "fullyIdle": true
      },
      "transcript_rows": [
        {
          "step_index": 0,
          "type": "USER_INPUT",
          "status": "DONE",
          "content": "<USER_REQUEST>\n你还记得我的猫吗\n</USER_REQUEST>"
        },
        {
          "step_index": 1,
          "type": "PLANNER_RESPONSE",
          "status": "DONE",
          "content": "  my_tool_call_analysis: inspect state",
          "tool_calls": []
        },
        {
          "step_index": 2,
          "type": "PLANNER_RESPONSE",
          "status": "DONE",
          "content": "记得，是橘猫阿树",
          "tool_calls": [],
          "thinking": "（思考不存）"
        }
      ],
      "expect_post": {
        "path": "stop",
        "fields": {
          "client": "antigravity"
        },
        "messages": [
          {
            "key": "u:agy:ag-1:0",
            "role": "user",
            "text": "你还记得我的猫吗"
          },
          {
            "key": "a:agy:ag-1:2",
            "role": "assistant",
            "text": "记得，是橘猫阿树"
          }
        ]
      },
      "expect_stdout": {}
    },
    {
      "name": "Stop USER_CANCELED：不存",
      "argv": [
        "--client",
        "antigravity",
        "stop"
      ],
      "stdin": {
        "conversationId": "ag-1",
        "workspacePaths": [
          "/w"
        ],
        "executionNum": 1,
        "terminationReason": "USER_CANCELED",
        "fullyIdle": true
      },
      "transcript_rows": [
        {
          "step_index": 0,
          "type": "USER_INPUT",
          "status": "DONE",
          "content": "<USER_REQUEST>\n你还记得我的猫吗\n</USER_REQUEST>"
        },
        {
          "step_index": 1,
          "type": "PLANNER_RESPONSE",
          "content": "好",
          "tool_calls": []
        }
      ],
      "expect_post": null,
      "expect_stdout": {}
    }
  ]
}
